    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "vite": "^8.3.4"
  }
